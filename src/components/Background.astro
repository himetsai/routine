---
// The site's Y2K backdrop, minus the animated hearts and sparkles:
// same gradient and vignette, held still. The hearts come back as confetti.
---

<div class="backdrop" aria-hidden="true">
  <div class="vignette"></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, #ffe4ec 0%, #ffd6e0 25%, #ffccd5 50%, #fce4ec 75%, #f3e5f5 100%);
    contain: strict;
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(220, 100, 130, 0.12) 75%, rgba(180, 60, 100, 0.22) 100%);
    pointer-events: none;
  }
</style>
